# PodAdresem24 environment example
#
# Copy only the relevant values to the environment panel of the provider.
# Do not commit real .env, .env.local, database URLs or secrets.

# -----------------------------------------------------------------------------
# Frontend: apps/web
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=https://podadresem24.pl
NEXT_PUBLIC_AGENT_APP_URL=https://app.podadresem24.pl
NEXT_PUBLIC_API_URL=https://api.podadresem24.pl/api

# Local frontend example:
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# -----------------------------------------------------------------------------
# Backend: apps/api
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=4000

# Current API CORS implementation reads FRONTEND_URL.
# For staging use the public portal URL. If app.podadresem24.pl is used for the
# agent panel, update API CORS code to support multiple origins before launch.
FRONTEND_URL=https://podadresem24.pl

# TypeORM currently reads DB_* variables, not DATABASE_URL.
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Keep disabled outside disposable local development.
TYPEORM_SYNCHRONIZE=false

# Auth cookies and JWT
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Use "none" when frontend and API are on different subdomains and both use HTTPS.
AUTH_COOKIE_SAME_SITE=none

# Future recommended variable after backend support is added:
# AUTH_COOKIE_DOMAIN=.podadresem24.pl

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PodAdresem <noreply@podadresem24.pl>"

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------

# Current runtime supports only "local".
# In NODE_ENV=production this requires FILE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true.
# Use this only for a controlled staging/beta. Public launch should use S3/R2 or
# Supabase Storage after implementing the adapter in API.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_ALLOW_LOCAL_IN_PRODUCTION=false
FILE_STORAGE_LOCAL_PUBLIC_ROOT=uploads
FILE_STORAGE_LOCAL_PRIVATE_ROOT=private-uploads
FILE_STORAGE_PUBLIC_BASE_URL=https://api.podadresem24.pl

# Future object storage variables, not currently consumed by the API runtime:
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_LISTING_IMAGES=listing-images
# S3_BUCKET_PROPERTY_DOCUMENTS=property-documents
# S3_BUCKET_AGENCY_ASSETS=agency-assets
# S3_BUCKET_USER_AVATARS=user-avatars
# S3_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Release flags
# -----------------------------------------------------------------------------

RELEASE_FLAG_PUBLIC_LISTINGS_ENABLED=true
RELEASE_FLAG_PUBLIC_LEAD_FORMS_ENABLED=true
RELEASE_FLAG_PUBLIC_CLAIM_FLOW_ENABLED=false
RELEASE_FLAG_FREEMIUM_UPSELL_ENABLED=true
RELEASE_FLAG_PREMIUM_REPORTS_ENABLED=true
RELEASE_FLAG_AGENT_LISTING_MARKETPLACE_ENABLED=true

# -----------------------------------------------------------------------------
# Plan limits / billing
# -----------------------------------------------------------------------------

PLAN_LIMIT_ENFORCEMENT_SCHEDULER_ENABLED=true
PLAN_LIMIT_ENFORCEMENT_SCHEDULER_HOUR=2
PLAN_LIMIT_ENFORCEMENT_SCHEDULER_MINUTE=15
PLAN_LIMIT_DOWNGRADE_GRACE_DAYS=7
BILLING_WEBHOOK_SECRET=change-me-generate-a-long-random-secret

# -----------------------------------------------------------------------------
# Geocoding
# -----------------------------------------------------------------------------

GEOCODING_PROVIDER=
GEOCODING_API_KEY=
GEOCODING_COUNTRY_BIAS=PL
GEOCODING_REQUEST_TIMEOUT_MS=3500
GEOCODING_CACHE_TTL_DAYS=180

# -----------------------------------------------------------------------------
# Optional monitoring
# -----------------------------------------------------------------------------

SENTRY_DSN=
